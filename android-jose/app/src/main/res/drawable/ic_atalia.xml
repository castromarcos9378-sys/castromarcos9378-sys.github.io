<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
  <item>
    <shape android:shape="rectangle">
      <solid android:color="#132B48"/>
      <corners android:radius="24dp"/>
    </shape>
  </item>
  <item android:left="10dp" android:right="10dp" android:top="10dp" android:bottom="10dp">
    <shape android:shape="oval">
      <stroke android:width="3dp" android:color="#C9A567"/>
      <solid android:color="#132B48"/>
    </shape>
  </item>
  <item android:left="27dp" android:right="27dp" android:top="32dp" android:bottom="32dp">
    <shape android:shape="rectangle">
      <solid android:color="#FFFFFF"/>
      <corners android:radius="4dp"/>
    </shape>
  </item>
</layer-list>
